# Copier ce fichier vers .env et remplir les valeurs

# Clé de session Flask (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-please-use-a-long-random-string

# Clé Fernet pour chiffrer les mots de passe SMTP
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# Compte administrateur créé au premier init-db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# URL de base (optionnel, utilisée dans les emails si besoin)
APP_BASE_URL=http://localhost:5000

# Mode debug (ne pas activer en production)
FLASK_DEBUG=0
